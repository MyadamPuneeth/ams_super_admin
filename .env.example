# Development only. Never reuse these credentials outside your machine.
DATABASE_URL=postgresql://ams_app:ams_local_only@127.0.0.1:55432/ams
MIGRATION_DATABASE_URL=postgresql://postgres:ams_local_admin@127.0.0.1:55432/ams
PORT=3001
WEB_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
USER_APP_ORIGIN=http://localhost:5173
MOBILE_APP_ORIGIN=http://localhost:5175
# Local preview only; rejected when NODE_ENV=production.
DEV_AUTH=true
# Set DEV_AUTH=false for Supabase authentication.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
PLATFORM_OWNER_USERNAME=platform.owner
PLATFORM_OWNER_PASSWORD=replace-with-at-least-12-characters
PLATFORM_OWNER_NAME=Platform Owner
# Required in production; generate a random value of at least 32 characters.
PLATFORM_SESSION_SECRET=
CREDENTIAL_HANDOFF_KEY=replace-with-a-stable-random-secret-of-32-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
