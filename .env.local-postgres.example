# Copy this file to .env after creating the ams database and ams_app role on
# your locally installed PostgreSQL server. Never commit the resulting .env.
DATABASE_URL=postgresql://ams_app:ams_local_only@127.0.0.1:5432/ams
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE_WITH_YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/ams
PORT=3001
WEB_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
USER_APP_ORIGIN=http://localhost:5173
MOBILE_APP_ORIGIN=http://localhost:5175
DEV_AUTH=true
PLATFORM_OWNER_USERNAME=platform.owner
PLATFORM_OWNER_PASSWORD=replace-with-at-least-12-characters
PLATFORM_OWNER_NAME=Platform Owner
PLATFORM_SESSION_SECRET=
CREDENTIAL_HANDOFF_KEY=replace-with-a-stable-random-secret-of-32-characters
# Gmail SMTP: enable Google 2-Step Verification and create an app password.
# Set SMTP_USERNAME to your full Gmail address; SMTP_PASSWORD is not an API key.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional: defaults to SMTP_USERNAME. Use your Gmail address or a verified alias.
SMTP_FROM=
